#!/bin/bash

# Serve the documentation locally with live reload.
#
#   ./serve            # http://localhost:4321
#   ./serve 4400       # http://localhost:4400
#   ./serve --build    # force an image rebuild first (after Dockerfile changes)
#
# The server loads the newest three versions. With all the versions, the dev
# server does not start in time (see src/lib/local-versions.mjs). To load
# other versions, set DOCS_VERSIONS:
#
#   DOCS_VERSIONS="6.0 5.22" ./serve
#
# Stop the server before running a build (`pnpm build`): both use the
# .astro/ cache.

set -e

IMAGE="phalcon-docs"
PORT="4321"
BUILD="no"

usage() {
    echo "Usage: ${0} [--build] [port]" >&2
    exit 1
}

for arg in "$@"; do
    if [[ "${arg}" == "--build" ]]; then
        BUILD="yes"
    elif [[ "${arg}" =~ ^[0-9]+$ ]]; then
        PORT="${arg}"
    else
        usage
    fi
done

if ! command -v docker > /dev/null 2>&1; then
    echo "docker is required but was not found in PATH" >&2
    exit 1
fi

cd "$(dirname "$0")"

if [[ "${BUILD}" == "yes" ]] || ! docker image inspect "${IMAGE}" > /dev/null 2>&1; then
    docker build -t "${IMAGE}" resources/docker
fi

if [[ ! -d node_modules ]]; then
    docker run --rm -v "$PWD":/docs "${IMAGE}" pnpm install --frozen-lockfile
fi

# A container stopped with Ctrl+C leaves the Astro dev-server lock on the
# bind mount. Remove it so the next start does not see a "running" server.
rm -f .astro/dev.json

# The newest three versions, for example "6.0 5.24 5.23".
if [[ -z "${DOCS_VERSIONS:-}" ]]; then
    DOCS_VERSIONS="$(for dir in src/content/docs-*/; do dir="${dir%/}"; echo "${dir#src/content/docs-}"; done | sort -rV | head -n 3 | tr '\n' ' ')"
fi

echo "Serving documentation at http://localhost:${PORT} (Ctrl+C to stop)"
echo "Versions: ${DOCS_VERSIONS}"
docker run --rm -it -p "${PORT}:4321" -e DOCS_VERSIONS="${DOCS_VERSIONS}" -v "$PWD":/docs "${IMAGE}"
