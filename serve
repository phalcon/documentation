#!/bin/bash

# Serve the documentation locally with live reload.
#
#   ./serve            # http://localhost:8000
#   ./serve 8100       # http://localhost:8100
#   ./serve --build    # force an image rebuild first (after Dockerfile changes)

set -e

IMAGE="phalcon-docs"
PORT="8000"
BUILD="no"

usage() {
    echo "Usage: ${0} [--build] [port]" >&2
    exit 1
}

for arg in "$@"; do
    if [[ "${arg}" == "--build" ]]; then
        BUILD="yes"
    elif [[ "${arg}" =~ ^[0-9]+$ ]]; then
        PORT="${arg}"
    else
        usage
    fi
done

if ! command -v docker > /dev/null 2>&1; then
    echo "docker is required but was not found in PATH" >&2
    exit 1
fi

cd "$(dirname "$0")"

if [[ "${BUILD}" == "yes" ]] || ! docker image inspect "${IMAGE}" > /dev/null 2>&1; then
    docker build -t "${IMAGE}" resources/docker
fi

echo "Serving documentation at http://localhost:${PORT} (Ctrl+C to stop)"
docker run --rm -it -p "${PORT}:8000" -v "$PWD":/docs "${IMAGE}"
